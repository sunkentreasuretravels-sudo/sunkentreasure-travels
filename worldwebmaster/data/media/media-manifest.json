{
  "version": 1,
  "rules": {
    "specific_asset_wins": true,
    "fallback_order": [
      "destination_or_country",
      "region",
      "global"
    ],
    "publish_only_approved": true,
    "retain_license_metadata": true
  },
  "assetTypes": [
    "image",
    "video"
  ],
  "statuses": [
    "uploaded",
    "processing",
    "ai_screened",
    "pending_review",
    "approved",
    "rejected",
    "published",
    "archived"
  ],
  "moderation": {
    "automated_screening": "flag_for_review",
    "human_approval_required": true,
    "automatic_publication": false
  }
}